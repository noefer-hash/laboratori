import java.util.*;

public class Problema1 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        boolean trobat = false;

        int x = s.nextInt();
        while (x != 0 && !trobat) {
            if (x % 2 == 0) trobat = true;
            x = s.nextInt();
        }

        if (trobat) System.out.println("SI");
        else System.out.println("NO");
    }
}
