import java.util.*;

public class Problema2 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int d = s.nextInt();
        int n = s.nextInt();
        boolean trobat = false;

        while (n > 0 && !trobat) {
            if (n % 10 == d) trobat = true;
            n /= 10;
        }

        if (trobat) System.out.println("SI");
        else System.out.println("NO");
    }
}
