import java.util.*;

public class Problema6 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        String seq = s.next();

        int bal = 0;
        boolean correcte = true;

        for (int i = 0; i < seq.length() && correcte; i++) {
            char c = seq.charAt(i);
            if (c == '(') bal++;
            else bal--;

            if (bal < 0) correcte = false;
        }

        if (correcte && bal == 0) System.out.println("yes");
        else System.out.println("no");
    }
}
